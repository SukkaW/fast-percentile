{
  "name": "fast-percentile",
  "version": "1.0.0",
  "description": "Fastest percentile computation in TypeScript / JavaScript for unsorted dataset, 4~7x faster than the second fastest alternative, at all dataset sizes. Powered by quickselect algorithm.",
  "repository": {
    "type": "git",
    "url": "https://github.com/SukkaW/fast-percentile"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "lint": "eslint --format=sukka .",
    "build": "bunchee --minify --no-sourcemap",
    "bench": "SWC_NODE_IGNORE_DYNAMIC=1 node src/index.bench.ts",
    "test": "SWC_NODE_IGNORE_DYNAMIC=1 SWC_NODE_INLINE_SOURCE_MAP=1 nyc mocha --require @swc-node/register --full-trace 'src/**/*.test.ts'",
    "prerelease": "pnpm run lint && pnpm run test && pnpm run build",
    "release": "bumpp --install -r --all --commit \"release: %s\" --tag \"%s\""
  },
  "keywords": [
    "statistics",
    "percentile",
    "quantile",
    "p99",
    "p95",
    "p50"
  ],
  "author": "SukkaW <https://skk.moe>",
  "license": "MIT",
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@mitata/counters": "^0.0.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.15.47",
    "@types/mocha": "^10.0.10",
    "bumpp": "^10.4.1",
    "bunchee": "^6.12.2",
    "earl": "^2.0.0",
    "eslint": "^10.8.1",
    "eslint-config-sukka": "^9.0.1",
    "eslint-formatter-sukka": "^9.0.1",
    "foxts": "^5.9.1",
    "just-percentile": "^4.2.0",
    "mitata": "^1.0.34",
    "mocha": "^11.8.0",
    "nyc": "^18.0.0",
    "percentile": "^1.6.0",
    "percentile-js": "^1.1.1",
    "stats-percentile": "^3.3.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.21.0"
}
